<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0c0e14">

    <!-- 顶部工具栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="#141720">

        <Button
            android:id="@+id/btnOpen"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="打开"
            android:textSize="12sp"
            android:backgroundTint="#1a1e2a"
            android:textColor="#00e5a0" />

        <Button
            android:id="@+id/btnNew"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="新建"
            android:textSize="12sp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#1a1e2a"
            android:textColor="#00e5a0" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="保存"
            android:textSize="12sp"
            android:backgroundTint="#00e5a0"
            android:textColor="#0c0e14" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252a3a" />

    <!-- PDF预览区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:background="#0c0e14">

        <ImageView
            android:id="@+id/pdfPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="4dp" />

        <!-- 页码导航浮层 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:padding="6dp"
            android:gravity="center_vertical"
            android:background="#cc141720">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:text="&lt;"
                android:textSize="12sp"
                android:padding="0dp"
                android:backgroundTint="#1a1e2a"
                android:textColor="#e4e8f1" />

            <TextView
                android:id="@+id/pageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="第 1 / 1 页"
                android:textColor="#e4e8f1"
                android:textSize="12sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:text="&gt;"
                android:textSize="12sp"
                android:padding="0dp"
                android:backgroundTint="#1a1e2a"
                android:textColor="#e4e8f1" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252a3a" />

    <!-- 文字预览区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/objInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击PDF上的文字可直接编辑"
            android:textColor="#00e5a0"
            android:textSize="12sp"
            android:paddingBottom="4dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#141720"
            android:padding="8dp">

            <TextView
                android:id="@+id/textPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#c8d0e8"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:text="(加载PDF后显示文字)" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>